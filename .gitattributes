# Normalise line endings so the tree is identical on Windows and Linux.
* text=auto eol=lf

# Windows-native scripts must keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.faiss binary
*.db binary

# Lockfiles and generated env files stay as-is.
.env.example text eol=lf
uv.lock text eol=lf