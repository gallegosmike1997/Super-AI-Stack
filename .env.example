# Super AI Stack - example environment.
#
#   cp .env.example .env     (or: Copy-Item .env.example .env on PowerShell)
#
# .env is gitignored; this file is the committed template. Every value below is
# the default that already applies when the variable is unset, so an empty file
# is a valid configuration. Run `sas env` to see what the stack actually reads.

# --- Inference backend -------------------------------------------------------
# Any OpenAI-compatible server: Ollama, vLLM, llama.cpp, or a hosted provider.
# In Docker on Windows/macOS use host.docker.internal instead of 127.0.0.1.
GENERAL_MODEL_BASE_URL=http://host.docker.internal:11434
GENERAL_MODEL_NAME=llama3.1

CODING_MODEL_BASE_URL=http://host.docker.internal:11434
CODING_MODEL_NAME=qwen2.5-coder:7b

REASONING_MODEL_BASE_URL=http://host.docker.internal:11434
REASONING_MODEL_NAME=deepseek-r1:8b

VISION_MODEL_BASE_URL=http://host.docker.internal:11434
VISION_MODEL_NAME=qwen2.5vl:3b

# Bearer token, only needed for hosted providers. Never commit a real value.
MODEL_API_KEY=

# --- Router -----------------------------------------------------------------
# Leave ROUTER_MODEL_BASE_URL empty to use the built-in keyword router; it needs
# no GPU and keeps working with the inference backend offline.
ROUTER_MODEL_BASE_URL=http://host.docker.internal:11434
ROUTER_MODEL_NAME=phi3:mini

# --- Generation budget and timeouts ----------------------------------------
# Uncapped generation runs to the context limit (~10 min on CPU) and looks like
# a hang, so keep a cap. The router only returns a small JSON object and needs
# far fewer tokens than an expert answering a question.
MODEL_MAX_TOKENS=1024
ROUTER_MAX_TOKENS=160

# Cold model loads on CPU are slow; keep this above the worst-case start.
MODEL_TIMEOUT=300

# A restarted runtime shows up as a connection error, so retry transports with
# backoff. A bad model tag returns 404 and is never retried.
MODEL_RETRIES=3
MODEL_RETRY_DELAY=3

# --- Gateway protection -----------------------------------------------------
# When set, every non-public endpoint requires the x-api-key header.
SUPER_AI_API_KEY=
# Requests per minute per client; 0 disables limiting.
RATE_LIMIT_PER_MINUTE=60

# --- Model swap scheduler ---------------------------------------------------
# Big models get exclusive residency so a swap never OOMs a small machine.
BIG_MODELS=llama3.1,deepseek-r1,qwen2.5-coder,mistral-large

# --- Image generation -------------------------------------------------------
# Stable Diffusion WebUI API. Unset means image_gen reports "queued" honestly
# instead of claiming an image was produced.
IMAGE_MODEL_BASE_URL=
IMAGE_MODEL_NAME=stable-diffusion-3

# --- Speech -----------------------------------------------------------------
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Agent ------------------------------------------------------------------
# Tool execution is deny-by-default. List only adapters you have implemented.
ALLOWED_TOOLS=

# --- Observability ----------------------------------------------------------
LOG_LEVEL=INFO